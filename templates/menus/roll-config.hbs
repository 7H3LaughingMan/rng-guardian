<form class="standard-form scrollable">

    {{#each ignoredRolls}}
    <div class="control" data-roll="{{value}}" data-index="{{index}}">
        <span>{{value}}</span>
        <a class="control" data-action="delete" title="Remove Roll" style="float: right;">
            <i class="fa-solid fa-xmark"></i>
        </a>
    </div>
    {{/each}}

    {{#if availableChoices.length}}
    <div class="form-group">
        <label>Roll</label>
        <div class="form-fields">
            <select name="roll">
                {{selectOptions availableChoices}}
            </select>
        </div>
    </div>
    {{/if}}
</form>